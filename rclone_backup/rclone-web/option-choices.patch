@@ -0,0 +1,73 @@
+import { expect, type Page, test } from '@playwright/test'
+import { getTestEnv, loginUrl } from './helpers'
+
+async function startICloudRemote(page: Page) {
+    await page.goto(loginUrl())
+    const { appUrl } = getTestEnv()
+    await page.waitForURL(appUrl + '/')
+    await page.goto(appUrl + '/remotes')
+    await page.getByRole('button', { name: 'Add New Remote' }).first().click()
+    await page.getByPlaceholder('Select type or search').fill('iCloud')
+    await page
+        .getByRole('option', { name: /^iCloud Drive/ })
+        .first()
+        .click()
+}
+
+// An option with examples starts filled with its default. A <datalist> then only suggests entries
+// that match that text, so the other choices (iCloud Photos here) cannot be found.
+test('every choice of an option with examples can be picked, even with a default filled in', async ({
+    page,
+}) => {
+    await startICloudRemote(page)
+
+    const service = page.getByLabel('service', { exact: true })
+    await expect(service).toHaveValue('drive')
+
+    await page.getByRole('button', { name: 'Choices for service' }).click()
+    await expect(page.getByRole('menuitem', { name: /^drive/ })).toBeVisible()
+    await page.getByRole('menuitem', { name: /^photos/ }).click()
+
+    await expect(service).toHaveValue('photos')
+})
+
+test('a value that is not one of the examples can still be typed', async ({ page }) => {
+    await startICloudRemote(page)
+
+    const service = page.getByLabel('service', { exact: true })
+    await service.fill('custom-value')
+    await expect(service).toHaveValue('custom-value')
+})
+
+// S3 provider choices have long help text, the widest menu in practice
+test('the choices menu stays inside a phone-width screen', async ({ page }) => {
+    await page.setViewportSize({ width: 360, height: 740 })
+    await page.goto(loginUrl())
+    const { appUrl } = getTestEnv()
+    await page.waitForURL(appUrl + '/')
+    await page.goto(appUrl + '/remotes')
+    await page.getByRole('button', { name: 'Add New Remote' }).first().click()
+    await page.getByPlaceholder('Select type or search').fill('Amazon S3')
+    await page.getByRole('option', { name: / s3$/ }).first().click()
+
+    await page.getByRole('button', { name: 'Choices for provider' }).click()
+    const menu = page.getByRole('menu')
+    await expect(menu).toBeVisible()
+    const box = await menu.boundingBox()
+    expect(box).not.toBeNull()
+    expect((box?.x ?? 0) + (box?.width ?? 0)).toBeLessThanOrEqual(360)
+    expect(await page.evaluate(() => document.documentElement.scrollWidth)).toBeLessThanOrEqual(360)
+})
+
+// The form sends passwords with obscure: true, so an already obscured value (copied from
+// rclone.conf) would be obscured twice. The field says what to type.
+test('a password field says to type the password itself', async ({ page }) => {
+    await startICloudRemote(page)
+
+    await expect(page.getByLabel('password', { exact: true })).toHaveAccessibleDescription(
+        /Type the password itself, not an obscured value/
+    )
+    await expect(page.getByLabel('apple_id', { exact: true })).not.toHaveAccessibleDescription(
+        /Type the password itself/
+    )
+})

diff --git a/src/lib/base.ts b/src/lib/base.ts
new file mode 100644
index 0000000..4a52de7
--- /dev/null
+++ b/src/lib/base.ts
@@ -0,0 +1,17 @@
+// The path the app is served from, ending in '/'. In a build this is derived from the bundle's own
+// URL (<base>/assets/index-*.js), so the app works at the root and under a reverse-proxy sub-path,
+// such as Home Assistant ingress, without a build-time setting.
+export const BASE_PATH = import.meta.env.DEV
+    ? '/'
+    : new URL(/* @vite-ignore */ '..', import.meta.url).pathname
+
+export const ROUTER_BASENAME = BASE_PATH.replace(/\/+$/, '') || '/'
+
+// Default rc URL when none is stored: the rcd instance that served the app (rclone rcd --rc-files).
+export const SAME_ORIGIN_URL = import.meta.env.DEV
+    ? ''
+    : new URL(BASE_PATH, window.location.origin).href.replace(/\/+$/, '')
+
+export function appPath(path: string) {
+    return `${BASE_PATH}${path.replace(/^\/+/, '')}`
+}
